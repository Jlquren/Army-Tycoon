-- Get Service --
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local Last = {}

local function CreateExplosion(target,Time)
	local explode = ReplicatedStorage.Effects.Explosion:Clone()
	explode.Parent = target.PrimaryPart
	explode.Enabled = true
	spawn(function()
		wait(Time)
		if explode then
			explode.Enabled = false
		end
		wait(.5)
		if explode then
			explode:Destroy()
		end
	end)
		--game.Debris:AddItem(explode,2)
end

