local function Tween(part,pos,timing)
	local goal = {}
	goal.Position = pos
	
	local info = TweenInfo.new(timing,Enum.EasingStyle.Linear)
	
	local tween = TweenService:Create(part, info, goal)
	tween:Play()
	
	return tween
end

local function CreateSound(name,parent,volume)
	parent = parent ~= nil and parent or workspace
	local sound = ReplicatedStorage.Sounds:FindFirstChild(name)
	if sound then
		sound = sound:Clone()
		sound.Parent = parent
		if volume then
			sound.Volume = volume
		end
		sound:Play()
		return sound
	end
end

local function DamageWithinRadius(pos,range,player,damage)
	for _,folder in pairs (workspace.Game.Units:GetChildren()) do
		for i,unit in pairs (folder:GetChildren()) do
			--print(unit)
			if unit and unit.PrimaryPart then
				local mag = (pos - unit.PrimaryPart.Position).magnitude
				if mag <= range then
					if folder.Name ~= player.Name then
						local uHuman = unit:FindFirstChildOfClass('Humanoid')
						if uHuman then
--							local remain = uHuman.Health - damage
--							if remain<=0 then
--								damage = uHuman.Health -1
--							else
--								damage = damage
--							end
							uHuman:TakeDamage(damage)
						end
					else
						--print('Not killing your own troop lol')
					end
				end
				--print('Missile is ',mag,' studs from',unit)
			end
		end
	end
end

local function Explosion(Type,mod,Bullet)
	if Type == 'Barrel' then
		local Visual = ReplicatedStorage.Models.BarrelExplosion:Clone()
		Visual.Parent = workspace
		Visual.Position = Bullet.Position
		local FireEmmit = Visual.Fire
		local SmokeEmmit = Visual.Smoke
		Bullet:Destroy()
		wait(2)
		repeat
			Visual.Size = Visual.Size - Vector3.new(.1,0,.1)
			wait(.05)
		until Visual.Size.X <= .5
		Visual:Destroy()
	elseif Type == 'Missile' then -- SET THIS UP
		local explosionSound = CreateSound('Explosion',Bullet)
		local fireSound = CreateSound('FireBurning',Bullet)
		Bullet.Transparency = 1
		local Emitter = Bullet.ParticleEmitter
		Emitter.Size = NumberSequence.new(0)
		Emitter.Enabled = true
		local size = mod.Range/3
		for i = 0,size,1.5 do
			Emitter.Size = NumberSequence.new(i,i)
			wait(.05)
		end
		wait(2)
		for i = .5,1,.025 do
			Emitter.Transparency = NumberSequence.new(i,1)
			wait(.05)
		end
		--print('Now')
		Bullet:Destroy()
	end
end

