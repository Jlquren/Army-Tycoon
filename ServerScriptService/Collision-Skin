-- Get Service -- 

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
 
local playerCollisionGroupName = "Players"

if not PhysicsService:IsCollisionGroupRegistered(playerCollisionGroupName) then
	PhysicsService:RegisterCollisionGroup(playerCollisionGroupName)
end

PhysicsService:CollisionGroupSetCollidable(
	playerCollisionGroupName,
	playerCollisionGroupName,
	false
)

local previousCollisionGroups = {}
 
local function setCollisionGroup(object)
	if object:IsA("BasePart") then
		previousCollisionGroups[object] = object.CollisionGroup
		object.CollisionGroup = playerCollisionGroupName
	end
end
 
local function setCollisionGroupRecursive(object)
  setCollisionGroup(object)
 
  for _, child in ipairs(object:GetChildren()) do
    setCollisionGroupRecursive(child)
  end
end
 
local function resetCollisionGroup(object)
	local previousCollisionGroupName = previousCollisionGroups[object]
	if not previousCollisionGroupName then return end

	object.CollisionGroup = previousCollisionGroupName
	previousCollisionGroups[object] = nil
end
 
local function onCharacterAdded(character)
  setCollisionGroupRecursive(character)
 
  character.DescendantAdded:Connect(setCollisionGroup)
  character.DescendantRemoving:Connect(resetCollisionGroup)
end

local function CheckSkinForUnit(unit,skinFolder,newSkin)
	if unit.Name ~= 'Fighter Jet' then
		if unit.PrimaryPart:IsA('MeshPart') then
			--unit.PrimaryPart.TextureID = skinFolder[newSkin].vehicleTextureID.Value
			for i,v in pairs (unit:GetChildren()) do
				if v:IsA('MeshPart') then
					v.TextureID = skinFolder[newSkin].vehicleTextureID.Value
				end
			end
		else
			local shirt = unit:FindFirstChildOfClass('Shirt')
			local pants = unit:FindFirstChildOfClass('Pants')
			if shirt then
				shirt.ShirtTemplate = skinFolder[newSkin].Unit.Shirt.ShirtTemplate
			end
			if pants then
				pants.PantsTemplate = skinFolder[newSkin].Unit.Pants.PantsTemplate
			end
		end
	end
end

