local function findinTable(player,tab)
	for i = #tab, 1, -1 do
		if tab[i].Who == player then
			return true, tab[i],i
		end
	end
	for i,v in pairs (tab) do
		if v == player then
			return true
		end
	end
	return false
end

local function updateTable(Player,actualBase,toggle,option)
	
	if actualBase == nil then
		
		for base,tab in pairs (Bases) do
			for i = #tab.Capturing,1,-1 do
				--print(tab.Capturing[i].Amount)
				if tab.Capturing[i].Who == Player then
					actualBase = base
					break
					--table.remove(tab.Capturing,i)
				end
			end
		end
		
	end
	
	if actualBase ~= nil then
		local found,tab,pos = findinTable(Player,Bases[actualBase].Capturing)
		local amt = toggle == true and 1 or toggle == false and -1
		if found then
			tab.Amount = tab.Amount + amt
		elseif not found and toggle == true then
			local new = {Who = Player, Amount = 1}
			table.insert(Bases[actualBase].Capturing,new)
		end
		
--		for i,v in pairs (Bases[actualBase].Capturing) do
--			print(i,v)
--			for a,b in pairs (v) do
--				print(a,b)
--			end
--		end
		
		if tab then
			if tab.Amount == 0 then
				table.remove(Bases[actualBase].Capturing,pos)
			end
		end
		
		if option ~= nil and option == 'ALL' then -- this only fires when the player is capturing their own thing
			table.remove(Bases[actualBase].Capturing,pos)
			
			CheckOwnerForBase(actualBase,Player)
		end
		
		local AmountTryingToCapture = #Bases[actualBase].Capturing
		
		if AmountTryingToCapture >=1 then
			--Player,
			Bases[actualBase].Active = true
		else
			--Player,
			Bases[actualBase].Active = false
		end
		
		--print(AmountTryingToCapture,'HERE1')
		--print(tab.Amount,'HERE2')
	end
end

