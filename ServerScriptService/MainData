MarketplaceService.ProcessReceipt = function(receiptInfo)
	local ProductId = receiptInfo.ProductId
	local PlayerId = receiptInfo.PlayerId
	local Player = PlayersService:GetPlayerByUserId(PlayerId)
	
	if not Player then
		print('Not processed yet')
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	
	if ProductId == MissilesMod.Nuke.Id then
		Remotes.ActivateMissile:FireClient(Player,'Nuke')
	end
	
	
	for amt,id in pairs (SettingsMod.Products.Money) do
		if ProductId == id then
				AddCashTo(Player,amt)
			break
		end
	end
	
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

