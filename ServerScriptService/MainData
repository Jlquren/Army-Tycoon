local function LoopSaveData()
	while true do
		wait(SettingsMod.AutosaveInterval)
		for i,v in ipairs(game.Players:GetPlayers()) do
			if PlayersStats[v] then
				savePlayerData(v,PlayersStats[v])
				Remotes.NotifyOfGameSave:FireClient(v)
			end
		end
	end
end

game.ReplicatedStorage.RE.BuyTurretRE.OnInvoke = function(player,turret)
