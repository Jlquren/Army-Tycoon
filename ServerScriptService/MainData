local function AddCashTo(Player,amount)
	--print(Player,amount)
	if PlayersStats[Player] then
		if amount ~= nil then
			PlayersStats[Player]['Money'] = PlayersStats[Player]['Money'] + amount
		end
		Remotes.changeGui:FireClient(Player,PlayersStats[Player]['Money'])
		--print('Cash updated')
	else
		
	end
end

local function AddSpawner(Player,pos)
	
	local closest,dist = nil,math.huge
	for i,v in pairs (workspace.Game.Base.Bases:GetChildren()) do
		local Spawner = v:FindFirstChild('Spawner')
		if Spawner then
			local Interactive = workspace.Game.Base.Interactives:FindFirstChild(v.Name)
			local mag = (Interactive.Position - pos).magnitude
			if mag < dist then
				if v.Spawner.Value == nil then
					closest = v
					dist = mag
				end
			end
		end
	end
	
	closest.Spawner.Value = Player
	
end

