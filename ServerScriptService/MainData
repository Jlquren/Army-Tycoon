local function TweenSize(setBase)
	local mSi = Bases[setBase].Base.Banner.OwnerCircle.Size
	local cSi = Bases[setBase].Base.Banner.OtherCircle.Size
	
	local x = .2
	local y = mSi.Y * (Bases[setBase].CapturingPercentage / 100)
	local z = mSi.Z * (Bases[setBase].CapturingPercentage / 100)
	
	local size = Vector3.new(x,y,z)
	local tween = TweenService:Create(Bases[setBase].Base.Banner.OtherCircle, info, {Size = size})
	tween:Play()
end

local function GivePercentage(setBase,product,Capturer)
		
	Bases[setBase].CapturingPercentage = product
	if GlobalsMod.ColorsTab[Capturer.Who.Name] then
		Bases[setBase].Base.Banner.OtherCircle.BrickColor = GlobalsMod.ColorsTab[Capturer.Who.Name] --Capturer.Who.TeamColor
	else
		print('Here')
	end
	
	if setBase.Name == 'CapturePoint' then
		if Bases[setBase].Owner ~= nil then
			if Capturer.Who.Name == Bases[setBase].Owner then
			Remotes.ForcedTarget:FireClient(Bases[setBase].Owner,nil)
			end
			--print('ForceTarget Removed')
		end
	end
	
	TweenSize(setBase)
	Bases[setBase].CurrentCapturer = Capturer.Who
end

local function TakePercentage(setBase) -- this needs to be set up properly 
	local speed = 10
	if setBase.Name == 'CapturePoint' then
		speed = HowFast
	else
		speed = HowFast2
	end
	local remaining = Bases[setBase].CapturingPercentage - (100/speed)
	if remaining < (100/speed) then
		if setBase.Name == 'CapturePoint' then
			if Bases[setBase].Owner ~= nil then
				Remotes.ForcedTarget:FireClient(Bases[setBase].Owner,nil)
				
				--print('ForceTarget Removed')
			end
		end
		Bases[setBase].CapturingPercentage = 0
		Bases[setBase].CurrentCapturer = ''
		delay(1,function()
			Bases[setBase].Base.Banner.OtherCircle.Size = Vector3.new(.4,0,0)
		end)
	else
		Bases[setBase].CapturingPercentage = remaining
	end
		
	local mSi = Bases[setBase].Base.Banner.OwnerCircle.Size
	
	if Bases[setBase].CapturingPercentage ~= 0 then -- make sure this is okay
		
		TweenSize(setBase)
	
	end
end

