Remotes.GetPurchasedPasses.OnInvoke = function(player,passId)
	
	local owned = false
	
	if PlayersPurchasedPasses[player] then
		for i,v in pairs (PlayersPurchasedPasses[player]) do
			if v == passId then
				owned = true
				break
			end
		end
	elseif passId >0 then
		owned = MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
		if owned == true then 
			if PlayersPurchasedPasses[player] == nil then
				PlayersPurchasedPasses[player] = {}
			end
			table.insert(PlayersPurchasedPasses[player],passId)
		end
	end
	
	return owned
	
end

local function savePlayerData(plr,data)
	if data ~= false then
		local success, err = pcall(function()
			PlayerDataStore:SetAsync(plr.UserId,data)
		end)
		if not success then
			warn("Cannot save data for player due to '" .. err .. "'")
		end
	else
		print(plr.Name .. "'s Data is false, NOT SAVING DATA")
	end
end

