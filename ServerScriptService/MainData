local function getTextObject(message, playerId)
	local textObject
	local success, errorMessage = pcall(function()
		textObject = TextService:FilterStringAsync(message, playerId)
	end)
	if success then
		return textObject
	elseif errorMessage then
		print("Error generating textObject")
	end
	return false
end

local function FilterName(text,playerID)
	local filtered = nil
	local success, reasoning = pcall(function()
		filtered = text:GetNonChatStringForUserAsync(playerID)
	end)
	if success then
		return filtered
	else
		print('Error filtering name',reasoning)
	end
	return false, reasoning
end

