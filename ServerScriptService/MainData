local function relinquish(player,button)
	PlayersStats[player].Buildings[button.Name] = nil
	if button.Name ~= "1" then
		button.Transparency = 1
		button.Icon.Transparency = 1
	else
		button.Transparency = 0
		button.Icon.Transparency = 0
		button.ClickDetector.MaxActivationDistance = 60
	end
	if button:FindFirstChildOfClass("Model") then
		button:FindFirstChildOfClass("Model"):Destroy()
	end
	local Max = game.ReplicatedStorage.RE.GetMaxUnits:Invoke(player)
	game.ReplicatedStorage.RE.UpdateMaxUnits:FireClient(player,Max)
end
