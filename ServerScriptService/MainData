local function AddHeroTo(Player,Hero,Name)
	if HeroesMod[Hero] then
		local Data = PlayersStats[Player]
		if Data then
			local sameName = false
			for i,v in pairs (Data.Heroes) do
				if v.name == Name then
					sameName = true
					break
				end
			end
			if sameName then
				return false,'SameName'
			else
				--PlayersStats[Player].Heroes[Name]
				local heroTable = {name = Name}
				table.insert(PlayersStats[Player].Heroes,heroTable)
				return true
			end
		end
	end
end

local function PurchaseHero(Player,Hero)
	if HeroesMod[Hero] then
		local Data = PlayersStats[Player]
		if Data then
			if #Data.Heroes < Data.MaxHeroAmount then
				if PlayersStats[Player]['Money'] >= HeroesMod[Hero].Cost then
					PlayersStats[Player]['Money'] = PlayersStats[Player]['Money'] - HeroesMod[Hero].Cost
					AddCashTo(Player,PlayersStats[Player]['Money'])
					--print(PlayersStats[Player]['Money'])
					return true
				else
					return false,'InsufficientFunds'
				end
			else
				return false,'Full'
			end
		else
			return false,'Data = nil'
		end
	else
		return false,'Heros mode for ' .. Hero..' Is not found'
	end
	return false
end

