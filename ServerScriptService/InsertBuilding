local function Relinquish(player,button,build)
	local model = button:FindFirstChildOfClass('Model')
	if model then
		if model == build then
			game.ReplicatedStorage.RE.RemoveButtonSave:Fire(player,button.Name)
			button.Transparency = 0
			button.Icon.Transparency = 0
			if button:FindFirstChildOfClass("Model") then
				button:FindFirstChildOfClass("Model"):Destroy()
			end
			--print(button.Name,'Destroyed')--, maybe check and see if the model is the same???
		else
			--print(model,'Different',build)
		end
	else
		--print('Model is nil')
	end
end

ReplicatedStorage.RE.DemolishFarm.OnServerEvent:Connect(function(player,button,build)
	if button then
		Relinquish(player,button,build)
	end
end)

game.ReplicatedStorage.RE.insertBuilding.OnServerEvent:connect(function(plr, building, button)
	AddBuilding(plr, building, button)
end)

game.ReplicatedStorage.RE.AddBuilding.Event:Connect(function(plr,building,button)
	button.Transparency = 1
	button.Icon.Transparency = 1
	AddBuilding(plr,building,button)
end)
